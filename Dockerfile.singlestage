# SINGLE-STAGE version - for comparison only.
# Everything stays in ONE stage, so build tools (gcc, libpq-dev) and
# pip's leftovers all remain in the final image. Built only to
# screenshot the size difference against the multi-stage image.

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY main.py .

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
